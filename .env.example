# Copia este archivo como .env.local y llena los valores de tu proyecto en Supabase
# (Supabase > Project Settings > API y > Database > Connection string).

# Conexión directa a Postgres (para migraciones y datos de ejemplo)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Claves públicas de Supabase (login y lectura desde la app)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
